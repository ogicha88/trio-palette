{
  "name": "trio-palette",
  "version": "1.0.0",
  "description": "3色の配色からデザインイメージを探せるモバイルファーストアプリ",
  "scripts": {
    "dev": "vite --port 5199",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply trio-palette-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply trio-palette-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "playwright test"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "hono": "^4.13.13",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "private": true
}
